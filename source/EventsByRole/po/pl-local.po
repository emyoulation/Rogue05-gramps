#: EventParticipantsById.gpr.py:20 EventParticipantsById.gpr.py:23
msgid "People with event ID"
msgstr "Osoby z identyfikatorem zdarzenia"

#: EventParticipantsById.gpr.py:22
msgid ""
"Matches people who participated in the event with the specified Gramps ID, "
"regardless of their role."
msgstr ""
"Dopasowuje osoby, które brały udział w zdarzeniu o podanym identyfikatorze "
"Gramps, bez względu na ich rolę."

#: EventParticipantsById.gpr.py:22
msgid "Event Gramps ID:"
msgstr "Identyfikator Gramps zdarzenia:"

#: EventParticipantsById.gpr.py:25
msgid ""
"Matches every person who participated in the event with the specified Gramps "
"ID, regardless of their role."
msgstr ""
"Dopasowuje każdą osobę, która brała udział w zdarzeniu o podanym identyfikatorze "
"Gramps, bez względu na jej rolę."

#: EventParticipantsById.gpr.py:28
msgid "Event filters"
msgstr "Filtry zdarzeń"
